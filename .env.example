# Environment: development | staging | production
# This determines which config/*.yaml file is loaded as defaults.
# Env vars below OVERRIDE the YAML values.
APP_ENV=development
PORT=8080

# Neon (staging/prod) example:
#   DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/interview_excel_staging?sslmode=require
# Local Postgres example:
DATABASE_URL=postgres://user:password@localhost:5432/interview_excel?sslmode=disable
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASSWORD=
DB_SSLMODE=disable
REDIS_ENABLED=false
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_TLS=false
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3010
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/google_callback
GOOGLE_CREDENTIALS_JSON=
JWT_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Cloudflare R2 (S3-compatible object storage) for image uploads.
# If unset, image uploads are disabled and /upload/image returns 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL that serves the bucket (custom domain or the r2.dev URL),
# no trailing slash. e.g. https://cdn.yourdomain.com
R2_PUBLIC_BASE_URL=
# Top-level folder inside the bucket for uploads (e.g. local, staging, production).
# Final object key is {STORAGE_ENV}/{role}/<uuid>.<ext>. Defaults to "local".
STORAGE_ENV=local
